<?xml version="1.0" encoding="utf-8"?>
<!-- AirWhispers talks TLS by default. Cleartext is permitted so that people who
     self-host on a LAN (http://192.168.x.x:8080) can use their own server; the
     app shows an explicit warning banner whenever the configured backend URL is
     not https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
