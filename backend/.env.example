# AirWhispers backend configuration.
#
# Nothing here is required for a local test run: `npm run dev` starts with the
# in-memory store, an insecure development secret and the demo console at /.
PORT=8080
HOST=0.0.0.0

# Postgres. Leave empty to run with the in-memory store (development only:
# a restart hands every device a new code).
# DATABASE_URL=postgres://airwhispers:airwhispers@localhost:5432/airwhispers

# REQUIRED in production: at least 32 characters (`openssl rand -base64 48`).
JWT_SECRET=dev-only-insecure-secret-change-me-please-32
# Access tokens are short-lived; devices refresh them silently with the secret
# they were given at registration — there is no login screen to show.
ACCESS_TOKEN_TTL_SECONDS=3600

# Set to false on a private server: existing devices keep working (they resume
# with their secret) but no new code can be handed out.
ALLOW_NEW_DEVICES=true

# Optional Firebase Cloud Messaging (HTTP v1) — only useful with the `fcm`
# Android flavor, which needs android/app/google-services.json.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"...","project_id":"..."}
# FCM_PROJECT_ID=your-project-id

# Privacy: keep message bodies out of the push payload (default) so only ids
# travel through Google's infrastructure; the app fetches the body over TLS.
PUSH_INCLUDES_CONTENT=false

TRUST_PROXY=false
LOG_LEVEL=info
