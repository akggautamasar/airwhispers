# AirWhispers backend configuration
PORT=8080
HOST=0.0.0.0

# Postgres. Leave empty to run with the in-memory store (development only).
# DATABASE_URL=postgres://airwhispers:airwhispers@localhost:5432/airwhispers

# REQUIRED in production: at least 32 characters.
JWT_SECRET=dev-only-insecure-secret-change-me-please-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=5184000

# Optional Firebase Cloud Messaging (HTTP v1). Paste the service-account JSON as
# a single line; the `fcm` Android flavor registers tokens against it.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"...","project_id":"..."}
# FCM_PROJECT_ID=your-project-id

# Privacy: keep message bodies out of the push payload (default) so only the
# ids travel through Google's infrastructure; the app fetches the body over TLS.
PUSH_INCLUDES_CONTENT=false

TRUST_PROXY=false
LOG_LEVEL=info
